{
  "name": "skill-shelf",
  "displayName": "Skill Shelf",
  "description": "Manage and sync skills from a GitHub repository",
  "version": "0.0.1",
  "publisher": "fintelligence",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skill-shelf-explorer",
          "title": "Skill Shelf",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "skill-shelf-explorer": [
        {
          "id": "skillShelfView",
          "name": "Skills",
          "contextualTitle": "Skill Shelf"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "skillShelfView",
        "contents": "스킬 저장소가 설정되지 않았습니다.\n\n[저장소 설정](command:skillShelf.setupRepository)",
        "when": "!skillShelf.isLoading"
      }
    ],
    "commands": [
      {
        "command": "skillShelf.refresh",
        "title": "Refresh Skills",
        "icon": "$(refresh)",
        "category": "Skill Shelf"
      },
      {
        "command": "skillShelf.configure",
        "title": "Configure Repository",
        "icon": "$(gear)",
        "category": "Skill Shelf"
      },
      {
        "command": "skillShelf.viewSkill",
        "title": "View Skill Details",
        "icon": "$(eye)",
        "category": "Skill Shelf"
      },
      {
        "command": "skillShelf.syncCopilotPrompts",
        "title": "Sync Skills to Copilot Prompts",
        "icon": "$(copilot)",
        "category": "Skill Shelf"
      },
      {
        "command": "skillShelf.setupRepository",
        "title": "저장소 설정",
        "category": "Skill Shelf"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "skillShelf.refresh",
          "when": "view == skillShelfView",
          "group": "navigation"
        },
        {
          "command": "skillShelf.configure",
          "when": "view == skillShelfView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "skillShelf.viewSkill",
          "when": "view == skillShelfView && viewItem == skill",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Skill Shelf",
      "properties": {
        "skillShelf.github.repoUrl": {
          "type": "string",
          "default": "",
          "description": "GitHub 저장소 URL (예: https://github.com/org/repo 또는 https://github.example.com/org/repo)"
        },
        "skillShelf.github.pat": {
          "type": "string",
          "default": "",
          "description": "GitHub Personal Access Token (PAT). 선택사항. 비공개 저장소 접속 시 필요합니다."
        },
        "skillShelf.github.branch": {
          "type": "string",
          "default": "master",
          "description": "GitHub 브랜치 이름"
        },
        "skillShelf.github.skillsPath": {
          "type": "string",
          "default": "/skills",
          "description": "저장소 내 스킬 디렉토리 경로 (루트는 /)"
        },
        "skillShelf.sync.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "스킬 자동 동기화 활성화 여부"
        },
        "skillShelf.sync.intervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 30,
          "markdownDescription": "원격 저장소 변경 감지 주기(초). 변경이 감지되면 모든 활성화된 동기화 대상에 반영됩니다. on/off는 `sync.enabled`로 제어합니다."
        },
        "skillShelf.sync.removeStaleSkills": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "동기화 시 원격 저장소에 없는 스킬을 로컬에서 삭제. 비활성화하면 원격에서 삭제된 스킬이 로컬 동기화 대상 폴더에 계속 남아있습니다."
        },
        "skillShelf.sync.targets.githubSkills": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "워크스페이스 `.github/skills/`에 동기화. **GitHub Copilot**이 이 경로의 스킬을 자동 인식합니다. 현재 프로젝트에만 적용됩니다."
        },
        "skillShelf.sync.targets.claudeSkills": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "워크스페이스 `.claude/skills/`에 동기화. **Claude Code**가 프로젝트 컨텍스트에서 이 경로의 스킬을 참조합니다. 현재 프로젝트에만 적용됩니다."
        },
        "skillShelf.sync.targets.githubSkillsGlobal": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "홈 디렉토리 `~/.github/skills/`에 동기화. **GitHub Copilot**이 모든 프로젝트에서 전역으로 이 스킬을 참조합니다. 모든 워크스페이스에 영향을 줍니다."
        },
        "skillShelf.sync.targets.claudeSkillsGlobal": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "홈 디렉토리 `~/.claude/skills/`에 동기화. **Claude Code**가 모든 프로젝트에서 전역으로 이 스킬을 참조합니다. 모든 워크스페이스에 영향을 줍니다."
        },
        "skillShelf.sync.targets.custom": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "추가 동기화 경로 목록. 상대 경로는 워크스페이스 기준, `~`로 시작하면 홈 디렉토리 기준으로 해석됩니다.\n\n예시: `~/.config/my-tool/skills`, `.vs/skills`"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "npm version patch --no-git-tag-version && npx vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.2"
  }
}
