{
  "name": "skill-inventory",
  "displayName": "Skill Inventory",
  "description": "Manage and sync skills from a GitHub repository",
  "version": "0.0.0",
  "publisher": "oshyun",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skill-inventory-explorer",
          "title": "Skill Inventory",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "skill-inventory-explorer": [
        {
          "id": "skillInventoryView",
          "name": "Skills",
          "contextualTitle": "Skill Inventory"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "skillInventoryView",
        "contents": "스킬 저장소가 설정되지 않았습니다.\n\n[저장소 설정](command:skillInventory.setupRepository)",
        "when": "!skillInventory.isLoading"
      }
    ],
    "commands": [
      {
        "command": "skillInventory.refresh",
        "title": "Refresh Skills",
        "icon": "$(refresh)",
        "category": "Skill Inventory"
      },
      {
        "command": "skillInventory.configure",
        "title": "Configure Repository",
        "icon": "$(gear)",
        "category": "Skill Inventory"
      },
      {
        "command": "skillInventory.viewSkill",
        "title": "View Skill Details",
        "icon": "$(eye)",
        "category": "Skill Inventory"
      },
      {
        "command": "skillInventory.setupRepository",
        "title": "저장소 설정",
        "category": "Skill Inventory"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "skillInventory.refresh",
          "when": "view == skillInventoryView",
          "group": "navigation"
        },
        {
          "command": "skillInventory.configure",
          "when": "view == skillInventoryView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "skillInventory.viewSkill",
          "when": "view == skillInventoryView && viewItem == skill",
          "group": "inline"
        }
      ]
    },
    "configuration": [
      {
        "id": "github",
        "title": "Source",
        "order": 2,
        "properties": {
          "skillInventory.source.repoUrl": {
            "order": 1,
            "type": "string",
            "default": "",
            "description": "스킬을 가져올 GitHub 저장소 URL (예: https://github.com/org/repo)"
          },
          "skillInventory.source.pat": {
            "order": 2,
            "type": "string",
            "default": "",
            "description": "GitHub Personal Access Token (PAT). 비공개 저장소 접속 시 필요합니다."
          },
          "skillInventory.source.branch": {
            "order": 3,
            "type": "string",
            "default": "master",
            "description": "읽어올 브랜치 이름"
          },
          "skillInventory.source.skillsPath": {
            "order": 4,
            "type": "string",
            "default": "/skills",
            "description": "저장소 내 스킬 루트 경로 (저장소 전체를 사용하려면 /)"
          }
        }
      },
      {
        "id": "sync",
        "title": "Sync",
        "order": 1,
        "properties": {
          "skillInventory.sync.autoSync": {
            "order": 1,
            "type": "boolean",
            "default": true,
            "description": "원격 저장소 변경을 주기적으로 감지하여 자동 동기화"
          },
          "skillInventory.sync.intervalSeconds": {
            "order": 2,
            "type": "number",
            "default": 30,
            "minimum": 30,
            "markdownDescription": "변경 감지 주기(초). `sync.autoSync`가 켜져 있을 때만 동작합니다."
          },
          "skillInventory.sync.removeStaleSkills": {
            "order": 3,
            "type": "boolean",
            "default": false,
            "markdownDescription": "원격에서 삭제된 스킬을 로컬 동기화 대상에서도 삭제. 꺼두면 원격 삭제 스킬이 로컬에 그대로 남습니다.\n\n⚠️ **이 옵션과 관계없이**, 원격과 동일한 이름의 스킬이 로컬에 있으면 동기화 시 **원격 버전으로 덮어씁니다.** 로컬 수정 내용은 유지되지 않습니다."
          }
        }
      },
      {
        "id": "syncTargets",
        "title": "Target",
        "order": 3,
        "properties": {
          "skillInventory.target": {
            "order": 1,
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "default": {
              ".agents/skills": false,
              ".claude/skills": true,
              ".github/skills": false,
              "~/.agents/skills": false,
              "~/.claude/skills": true,
              "~/.github/skills": false
            },
            "markdownDescription": "동기화 대상 경로 목록\n\n예: `{\".claude/skills\": true, \"~/.config/my-tool/skills\": true}`"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "bash scripts/build.sh"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.2"
  }
}
