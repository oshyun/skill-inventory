{
  "name": "skill-inventory",
  "displayName": "Skill Inventory",
  "description": "Manage and sync skills from a GitHub repository",
  "version": "0.0.0",
  "publisher": "oshyun",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skill-inventory-explorer",
          "title": "Skill Inventory",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "skill-inventory-explorer": [
        {
          "id": "skillInventoryView",
          "name": "Skills",
          "contextualTitle": "Skill Inventory"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "skillInventoryView",
        "contents": "Loading...",
        "when": "!skillInventory.isReady"
      },
      {
        "view": "skillInventoryView",
        "contents": "No repository configured.\n\n[Setup Repository](command:skillInventory.setupRepository)",
        "when": "skillInventory.isReady && !skillInventory.isLoading"
      }
    ],
    "commands": [
      {
        "command": "skillInventory.refresh",
        "title": "Refresh Skills",
        "icon": "$(refresh)",
        "category": "Skill Inventory"
      },
      {
        "command": "skillInventory.configure",
        "title": "Configure Repository",
        "icon": "$(gear)",
        "category": "Skill Inventory"
      },
      {
        "command": "skillInventory.viewSkill",
        "title": "View Skill Details",
        "icon": "$(eye)",
        "category": "Skill Inventory"
      },
      {
        "command": "skillInventory.setupRepository",
        "title": "Setup Repository",
        "category": "Skill Inventory"
      },
      {
        "command": "skillInventory.changePat",
        "title": "Change Personal Access Token",
        "category": "Skill Inventory"
      },
      {
        "command": "skillInventory.ignoreSkill",
        "title": "Protect Local (Ignore Remote Updates)",
        "category": "Skill Inventory"
      },
      {
        "command": "skillInventory.unignoreSkill",
        "title": "Unprotect Local (Resume Remote Sync)",
        "category": "Skill Inventory"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "skillInventory.refresh",
          "when": "view == skillInventoryView",
          "group": "navigation"
        },
        {
          "command": "skillInventory.configure",
          "when": "view == skillInventoryView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "skillInventory.ignoreSkill",
          "when": "view == skillInventoryView && viewItem == skill",
          "group": "1_sync"
        },
        {
          "command": "skillInventory.unignoreSkill",
          "when": "view == skillInventoryView && viewItem == skill-ignored",
          "group": "1_sync"
        }
      ]
    },
    "configuration": [
      {
        "id": "github",
        "title": "Source",
        "order": 2,
        "properties": {
          "skillInventory.source.repoUrl": {
            "order": 1,
            "type": "string",
            "default": "",
            "description": "GitHub repository URL to fetch skills from"
          },
          "skillInventory.source.branch": {
            "order": 3,
            "type": "string",
            "default": "master",
            "description": "Branch name to read skills from"
          },
          "skillInventory.source.skillsPath": {
            "order": 4,
            "type": "string",
            "default": "skills",
            "markdownDescription": "Path within the repository where skill folders are located. Each subfolder containing a `SKILL.md` is treated as one skill.\n\n**The sync target paths (e.g. `.claude/skills`) map directly to this path** — files are mirrored 1:1. For example, `.claude/skills/my-skill/SKILL.md` corresponds to `<skillsPath>/my-skill/SKILL.md` in the repository.\n\nUse `/` to treat the entire repository root as the skills path."
          }
        }
      },
      {
        "id": "sync",
        "title": "Sync",
        "order": 1,
        "properties": {
          "skillInventory.sync.autoSync": {
            "order": 1,
            "type": "boolean",
            "default": true,
            "description": "Periodically check for remote changes and sync skills automatically"
          },
          "skillInventory.sync.intervalSeconds": {
            "order": 2,
            "type": "number",
            "default": 30,
            "minimum": 30,
            "description": "Polling interval in seconds. Only effective when sync.autoSync is enabled."
          },
          "skillInventory.sync.removeStaleSkills": {
            "order": 3,
            "type": "boolean",
            "default": true,
            "markdownDescription": "When enabled, skills removed from the remote will be flagged for deletion. **You will always be prompted to confirm before anything is deleted.**\n\nWhen disabled, stale skills remain on disk and a warning is shown instead."
          },
          "skillInventory.sync.keepLocalSkills": {
            "order": 4,
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Skills to keep locally even after they are removed from the remote. Only affects stale deletion — sync (write/overwrite) is unaffected. If the skill still exists in the remote, it will continue to be updated normally. Use the skill folder name only — e.g. 'my-skill'. Right-click a skill in the tree view to add or remove it."
          }
        }
      },
      {
        "id": "syncTargets",
        "title": "Target",
        "order": 3,
        "properties": {
          "skillInventory.target": {
            "order": 1,
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "default": {
              ".agents/skills": false,
              ".claude/skills": true,
              ".github/skills": false,
              "~/.agents/skills": false,
              "~/.claude/skills": true,
              "~/.github/skills": false
            },
            "description": "Local paths to sync skills into."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "bundle:watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "package": "bash scripts/build.sh"
  },
  "devDependencies": {
    "@octokit/rest": "^20.1.2",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
