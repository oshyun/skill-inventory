{
  "name": "fdc-skills",
  "displayName": "FDC Skills",
  "description": "Manage FDC skills from a GitHub repository",
  "version": "0.0.10",
  "publisher": "fintelligence",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fdc-skills-explorer",
          "title": "FDC Skills",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "fdc-skills-explorer": [
        {
          "id": "fdcSkillsView",
          "name": "Skills",
          "contextualTitle": "FDC Skills"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fdcSkillsView",
        "contents": "No skills found.\n\nConfigure repository in [Settings](command:workbench.action.openSettings?%22fdcSkills.github%22).",
        "when": "!fdcSkills.isLoading"
      }
    ],
    "commands": [
      {
        "command": "fdcSkills.refresh",
        "title": "Refresh Skills",
        "icon": "$(refresh)",
        "category": "FDC Skills"
      },
      {
        "command": "fdcSkills.configure",
        "title": "Configure Repository",
        "icon": "$(gear)",
        "category": "FDC Skills"
      },
      {
        "command": "fdcSkills.viewSkill",
        "title": "View Skill Details",
        "icon": "$(eye)",
        "category": "FDC Skills"
      },
      {
        "command": "fdcSkills.syncCopilotPrompts",
        "title": "Sync Skills to Copilot Prompts",
        "icon": "$(copilot)",
        "category": "FDC Skills"
      },
      {
        "command": "fdcSkills.enableSync",
        "title": "Enable Auto Sync",
        "icon": "$(sync-ignored)",
        "category": "FDC Skills"
      },
      {
        "command": "fdcSkills.disableSync",
        "title": "Disable Auto Sync",
        "icon": "$(sync)",
        "category": "FDC Skills"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fdcSkills.refresh",
          "when": "view == fdcSkillsView",
          "group": "navigation"
        },
        {
          "command": "fdcSkills.configure",
          "when": "view == fdcSkillsView",
          "group": "navigation"
        },
        {
          "command": "fdcSkills.enableSync",
          "when": "view == fdcSkillsView && !fdcSkills.syncEnabled",
          "group": "navigation"
        },
        {
          "command": "fdcSkills.disableSync",
          "when": "view == fdcSkillsView && fdcSkills.syncEnabled",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "fdcSkills.viewSkill",
          "when": "view == fdcSkillsView && viewItem == skill",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "FDC Skills",
      "properties": {
        "fdcSkills.github.repoUrl": {
          "type": "string",
          "default": "https://oss.fin.navercorp.com/fintelligence/skills-hub.git",
          "description": "GitHub Enterprise repository URL (e.g. https://github.example.com/org/repo.git)"
        },
        "fdcSkills.github.pat": {
          "type": "string",
          "default": "",
          "description": "GitHub Personal Access Token (PAT)"
        },
        "fdcSkills.github.branch": {
          "type": "string",
          "default": "master",
          "description": "GitHub branch name"
        },
        "fdcSkills.github.skillsPath": {
          "type": "string",
          "default": "/",
          "description": "Path to skills directory in the repository (use / for root)"
        },
        "fdcSkills.autoRefreshInterval": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "Auto-refresh interval in seconds (0 to disable). Polls the server for changes and refreshes if skills were modified."
        },
        "fdcSkills.copilot.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync skills to .github/prompts/ for Copilot Chat integration"
        },
        "fdcSkills.copilot.syncTargets": {
          "type": "array",
          "items": {
            "type": "object",
            "title": "Sync Target",
            "properties": {
              "path": {
                "type": "string",
                "description": "Target directory path for skill synchronization (e.g., .github/skills, .claude/skills)"
              },
              "enabled": {
                "type": "boolean",
                "description": "Enable or disable synchronization to this target",
                "default": true
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "default": [
            {
              "path": ".github/skills",
              "enabled": true
            },
            {
              "path": ".claude/skills",
              "enabled": true
            }
          ],
          "markdownDescription": "Configure multiple target directories for skill synchronization.\n\nEach target can be individually enabled or disabled:\n- **path**: Directory path where skills will be synchronized\n- **enabled**: Toggle synchronization on/off for this target\n\nExample: Add `.claude/skills` or `.vs/skills` as additional sync targets"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "npm version patch --no-git-tag-version && npx vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.2"
  }
}
