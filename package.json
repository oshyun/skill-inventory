{
  "name": "skill-inventory",
  "displayName": "Skill Inventory",
  "description": "Manage and sync skills from a GitHub repository",
  "version": "0.0.0",
  "publisher": "oshyun",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skill-inventory-explorer",
          "title": "Skill Inventory",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "skill-inventory-explorer": [
        {
          "id": "skillInventoryView",
          "name": "Skills",
          "contextualTitle": "Skill Inventory"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "skillInventoryView",
        "contents": "스킬 저장소가 설정되지 않았습니다.\n\n[저장소 설정](command:skillInventory.setupRepository)",
        "when": "!skillInventory.isLoading"
      }
    ],
    "commands": [
      {
        "command": "skillInventory.refresh",
        "title": "Refresh Skills",
        "icon": "$(refresh)",
        "category": "Skill Inventory"
      },
      {
        "command": "skillInventory.configure",
        "title": "Configure Repository",
        "icon": "$(gear)",
        "category": "Skill Inventory"
      },
      {
        "command": "skillInventory.viewSkill",
        "title": "View Skill Details",
        "icon": "$(eye)",
        "category": "Skill Inventory"
      },
      {
        "command": "skillInventory.syncCopilotPrompts",
        "title": "Sync Skills to Copilot Prompts",
        "icon": "$(copilot)",
        "category": "Skill Inventory"
      },
      {
        "command": "skillInventory.setupRepository",
        "title": "저장소 설정",
        "category": "Skill Inventory"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "skillInventory.refresh",
          "when": "view == skillInventoryView",
          "group": "navigation"
        },
        {
          "command": "skillInventory.configure",
          "when": "view == skillInventoryView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "skillInventory.viewSkill",
          "when": "view == skillInventoryView && viewItem == skill",
          "group": "inline"
        }
      ]
    },
    "configuration": [
      {
        "id": "github",
        "title": "GitHub 연결",
        "order": 1,
        "properties": {
          "skillInventory.github.repoUrl": {
            "order": 1,
            "type": "string",
            "default": "",
            "description": "스킬을 가져올 GitHub 저장소 URL (예: https://github.com/org/repo)"
          },
          "skillInventory.github.pat": {
            "order": 2,
            "type": "string",
            "default": "",
            "description": "GitHub Personal Access Token (PAT). 비공개 저장소 접속 시 필요합니다."
          },
          "skillInventory.github.branch": {
            "order": 3,
            "type": "string",
            "default": "master",
            "description": "읽어올 브랜치 이름"
          },
          "skillInventory.github.skillsPath": {
            "order": 4,
            "type": "string",
            "default": "/skills",
            "description": "저장소 내 스킬 루트 경로 (저장소 전체를 사용하려면 /)"
          }
        }
      },
      {
        "id": "sync",
        "title": "동기화",
        "order": 2,
        "properties": {
          "skillInventory.sync.enabled": {
            "order": 1,
            "type": "boolean",
            "default": true,
            "description": "원격 저장소 변경을 주기적으로 감지하여 자동 동기화"
          },
          "skillInventory.sync.intervalSeconds": {
            "order": 2,
            "type": "number",
            "default": 30,
            "minimum": 30,
            "markdownDescription": "변경 감지 주기(초). `sync.enabled`가 켜져 있을 때만 동작합니다."
          },
          "skillInventory.sync.removeStaleSkills": {
            "order": 3,
            "type": "boolean",
            "default": false,
            "description": "원격에서 삭제된 스킬을 로컬 동기화 대상에서도 삭제. 꺼두면 원격 삭제 스킬이 로컬에 그대로 남습니다."
          }
        }
      },
      {
        "id": "syncTargets",
        "title": "동기화 대상",
        "order": 3,
        "properties": {
          "skillInventory.sync.targets.githubSkills": {
            "order": 1,
            "type": "boolean",
            "default": true,
            "markdownDescription": "**[프로젝트]** `.github/skills/`를 동기화합니다."
          },
          "skillInventory.sync.targets.claudeSkills": {
            "order": 2,
            "type": "boolean",
            "default": true,
            "markdownDescription": "**[프로젝트]** `.claude/skills/`를 동기화합니다."
          },
          "skillInventory.sync.targets.githubSkillsGlobal": {
            "order": 3,
            "type": "boolean",
            "default": false,
            "markdownDescription": "**[전역]** `~/.github/skills/`를 동기화합니다."
          },
          "skillInventory.sync.targets.claudeSkillsGlobal": {
            "order": 4,
            "type": "boolean",
            "default": false,
            "markdownDescription": "**[전역]** `~/.claude/skills/`를 동기화합니다."
          },
          "skillInventory.sync.targets.custom": {
            "order": 5,
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "추가 동기화 경로. 상대 경로는 워크스페이스 기준, `~/`로 시작하면 홈 디렉토리 기준입니다.\n\n예: `~/.config/my-tool/skills`, `.vs/skills`"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "node scripts/bump-version.js && npx vsce package --allow-missing-repository && git checkout -- package.json"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.2"
  }
}
