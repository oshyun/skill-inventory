{
  "name": "fdc-skills",
  "displayName": "FDC Skills",
  "description": "Manage FDC skills from a GitHub repository",
  "version": "0.0.11",
  "publisher": "fintelligence",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fdc-skills-explorer",
          "title": "FDC Skills",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "fdc-skills-explorer": [
        {
          "id": "fdcSkillsView",
          "name": "Skills",
          "contextualTitle": "FDC Skills"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fdcSkillsView",
        "contents": "No skills found.\n\nConfigure repository in [Settings](command:workbench.action.openSettings?%22fdcSkills.github%22).",
        "when": "!fdcSkills.isLoading"
      }
    ],
    "commands": [
      {
        "command": "fdcSkills.refresh",
        "title": "Refresh Skills",
        "icon": "$(refresh)",
        "category": "FDC Skills"
      },
      {
        "command": "fdcSkills.configure",
        "title": "Configure Repository",
        "icon": "$(gear)",
        "category": "FDC Skills"
      },
      {
        "command": "fdcSkills.viewSkill",
        "title": "View Skill Details",
        "icon": "$(eye)",
        "category": "FDC Skills"
      },
      {
        "command": "fdcSkills.syncCopilotPrompts",
        "title": "Sync Skills to Copilot Prompts",
        "icon": "$(copilot)",
        "category": "FDC Skills"
      },
      {
        "command": "fdcSkills.enableSync",
        "title": "Enable Auto Sync",
        "icon": "$(sync-ignored)",
        "category": "FDC Skills"
      },
      {
        "command": "fdcSkills.disableSync",
        "title": "Disable Auto Sync",
        "icon": "$(sync)",
        "category": "FDC Skills"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fdcSkills.refresh",
          "when": "view == fdcSkillsView",
          "group": "navigation"
        },
        {
          "command": "fdcSkills.configure",
          "when": "view == fdcSkillsView",
          "group": "navigation"
        },
        {
          "command": "fdcSkills.enableSync",
          "when": "view == fdcSkillsView && !fdcSkills.syncEnabled",
          "group": "navigation"
        },
        {
          "command": "fdcSkills.disableSync",
          "when": "view == fdcSkillsView && fdcSkills.syncEnabled",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "fdcSkills.viewSkill",
          "when": "view == fdcSkillsView && viewItem == skill",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "FDC Skills",
      "properties": {
        "fdcSkills.github.repoUrl": {
          "type": "string",
          "default": "https://oss.fin.navercorp.com/fintelligence/skills-hub.git",
          "description": "GitHub Enterprise 저장소 URL (예: https://github.example.com/org/repo.git)"
        },
        "fdcSkills.github.pat": {
          "type": "string",
          "default": "",
          "description": "GitHub Personal Access Token (PAT)"
        },
        "fdcSkills.github.branch": {
          "type": "string",
          "default": "master",
          "description": "GitHub 브랜치 이름"
        },
        "fdcSkills.github.skillsPath": {
          "type": "string",
          "default": "/",
          "description": "저장소 내 스킬 디렉토리 경로 (루트는 /)"
        },
        "fdcSkills.sync.enabled": {
          "type": "boolean",
          "default": true,
          "description": "스킬 자동 동기화 활성화 여부. false → true로 변경 시 즉시 동기화 실행"
        },
        "fdcSkills.sync.intervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 30,
          "description": "자동 동기화 주기(초). 활성화 여부는 sync.enabled로 제어"
        },
        "fdcSkills.sync.removeStaleSkills": {
          "type": "boolean",
          "default": true,
          "description": "자동 동기화 시 원격 저장소에 없는 스킬을 로컬에서 삭제"
        },
        "fdcSkills.sync.targets": {
          "type": "array",
          "items": {
            "type": "object",
            "title": "Sync Target",
            "properties": {
              "path": {
                "type": "string",
                "description": "동기화 대상 디렉토리 경로 (예: .github/skills, .claude/skills)"
              },
              "enabled": {
                "type": "boolean",
                "description": "해당 대상의 동기화 활성화 여부",
                "default": true
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "default": [
            {
              "path": ".github/skills",
              "enabled": true
            },
            {
              "path": ".claude/skills",
              "enabled": true
            }
          ],
          "markdownDescription": "스킬 동기화 대상 폴더를 설정합니다.\n\n각 대상은 개별적으로 활성화/비활성화할 수 있습니다:\n- **path**: 스킬이 동기화될 디렉토리 경로\n- **enabled**: 해당 대상의 동기화 활성화/비활성화\n\n예시: `.claude/skills` 또는 `.vs/skills`를 추가 동기화 대상으로 설정"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "npm version patch --no-git-tag-version && npx vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.2"
  }
}
